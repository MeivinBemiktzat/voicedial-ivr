; ---------------------------------------------------------------------
; דוגמת קובץ ext.ini לשלוחת החיוג הקולי (type=api)
; יש למקם קובץ זה (בשם ext.ini, ללא הסיומת .example) בתוך תיקיית השלוחה
; שתוקם לצורך המערכת, לדוגמה שלוחה 5 תחת השלוחה הראשית.
; ---------------------------------------------------------------------

type=api

; כתובת ה-endpoint שהוקם ב-Vercel (יש להחליף לכתובת הפרויקט בפועל)
api_link=https://YOUR-PROJECT-NAME.vercel.app/api/index

; שליחת הבקשות ב-POST (מומלץ)
api_url_post=yes

; תיקיית ברירת המחדל לשמירת הקלטות - צריכה להתאים בדיוק לערך
; YEMOT_RECORDING_DIR שמוגדר כמשתנה סביבה ב-Vercel (ברירת המחדל שם: /5)
api_dir=/5

; --------------------------------------------------------------------
; טוקן ה-API של ימות המשיח (להורדת קובצי הקלטה דרך ה-Management API)
; --------------------------------------------------------------------
; בכוונה *אין* להגדיר כאן/ב-Vercel מספר מערכת וסיסמה בנפרד - כל בקשה
; לשרת שלנו מצרפת את הטוקן בעצמה, כפרמטר קבוע (ראו api_add_0 למטה),
; כך שאין צורך בשום משתנה סביבה רגיש ב-Vercel.
;
; יש להנפיק טוקן API קבוע (שאינו פג תוקף אחרי 30 דקות) דרך אתר הניהול
; של ימות המשיח, ולהציב אותו כאן במקום YOUR-YEMOT-API-TOKEN.
; (ההגדרה api_add_0 היא המנגנון התיעודי של ימות לצירוף פרמטר קבוע לכל
; פנייה לשרת ה-API - ניתן להשתמש גם ב-api_add_1, api_add_2 וכו' עבור
; פרמטרים קבועים נוספים בעתיד, תוך שמירה על רצף סידורי החל מ-0):
api_add_0=ApiYemotToken=YOUR-YEMOT-API-TOKEN

; השאלה הראשונה והיחידה שמוגדרת מראש בקובץ ה-ext.ini: הקלטת הכוונה
; החופשית של המתקשר. כל שאר הדו-שיח (תפריטים, הוספת איש קשר) מתנהל
; דינמית על ידי תשובות ה-read שה-API שלנו מחזיר - ולכן אין צורך
; להגדיר כאן שאלות נוספות.
;
; פירוט הערכים (לפי מודול ה-API בימות):
;   Utterance   - שם הפרמטר שיישלח לשרת
;   (ריק)       - לא להשתמש בערך קיים (תמיד להקליט מחדש)
;   record      - סוג הנתון: הקלטה גולמית (ולא voice - בכוונה, כנדרש)
;   /5          - תיקיית השמירה
;   recording   - שם הקובץ שיישמר (ללא סיומת) -> /5/recording.wav
;   no          - בהקשה על # ההקלטה מאושרת מיידית (ללא תפריט אישור)
;   yes         - שמירת ההקלטה גם אם המשתמש ניתק באמצע
;   3           - אורך מינימלי בשניות
;   25          - אורך מקסימלי בשניות
api_000=Utterance,,record,/5,recording,no,yes,3,25

; הודעת פתיחה לפני ההקלטה הראשונה - יש להעלות קובץ 000.wav (או 000.tts)
; לשלוחה עם הטקסט/הקלטה המתאימה, לדוגמה:
; "שלום! לאחר הצליל, אנא אמרו למי להתקשר, או אמרו שיחות אחרונות,
;  אנשי קשר, או הוסף איש קשר"
; (ראה בתיעוד ימות כיצד ליצור קובץ TTS: 000.tts עם השורה הרצויה)

; ביטול השמעת "ביפ" לפני ההקלטה (אופציונלי)
; api_record_beep=no

; מה לעשות אם אין מענה מהשרת בזמן סביר / תשובה לא תקינה - ברירת המחדל
; תשמיע M1607 ותוציא את המשתמש מהשלוחה. ניתן להגדיר יעד חלופי לסיום:
; api_end_goto=/1
